{
  "name": "pi-webui",
  "version": "0.3.0",
  "private": true,
  "description": "Pi Agent WebUI — browser renderer for the pi coding agent",
  "homepage": "https://github.com/DLYZZT/pi-desktop#readme",
  "license": "Apache-2.0",
  "author": "DLYZZT",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "imports": {
    "#test-bundle": "./scripts/test-bundle.mjs",
    "#test-timing": "./scripts/test-timing.mjs"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsup && node out/server/main.mjs",
    "build:renderer": "vite build",
    "build:server": "tsup",
    "start": "node out/server/main.mjs",
    "lint": "eslint src scripts *.ts *.mjs --max-warnings=0",
    "lint:fix": "eslint src scripts *.ts *.mjs --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "test:server": "node scripts/test-standalone-server.mjs",
    "bench:sessions": "node scripts/bench-sessions.mjs",
    "check:contract": "node scripts/check-contract-coverage.mjs",
    "check:pi-compat": "node scripts/check-pi-compatibility.mjs",
    "check:i18n": "node scripts/check-renderer-i18n.mjs",
    "check:browser-i18n": "node scripts/check-renderer-i18n.mjs",
    "check:dependencies": "node scripts/check-dependency-contract.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:build-watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-tsup-watch.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-telemetry": "1.0.0",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@lobehub/icons": "^5.6.0",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.3",
    "@rc-component/qrcode": "^2.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.3",
    "mermaid": "^11.17.2",
    "preact": "^11.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semver": "7.8.5",
    "silk-wasm": "^3.7.1",
    "tar": "7.5.22",
    "typebox": "1.3.27",
    "ws": "^8.22.0",
    "yaml": "2.9.0",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "@earendil-works/pi-telemetry": "1.0.0",
    "@xmldom/xmldom": "0.8.15"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "22.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-test-renderer": "^19.1.0",
    "@types/semver": "7.7.1",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "0.27.7",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8",
    "prettier": "^3.9.5",
    "react-test-renderer": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "tsup": "8.5.1",
    "typescript": "^5",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.3.5"
  }
}
